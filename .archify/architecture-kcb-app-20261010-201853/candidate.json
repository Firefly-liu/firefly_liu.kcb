  "cards": [
    {
      "dot": "cyan",
      "title": "调休模型（只追加，永不改原始数据）",
      "items": [
        "DateRemap：某天按星期几的课表执行；sourceWeekday 为空即当天放假",
        "InstanceOverride：单节课的增删，带来源标记",
        "优先级唯一顺序：实例覆盖 > 日期重映射 > 原始课程",
        "撤销 = 删掉一条记录，渲染时重新合成"
      ]
    },
    {
      "dot": "emerald",
      "title": "课表抓取（用户手动触发）",
      "items": [
        "WebView 伪装桌面 UA，用户自己登录、自己点到课表页",
        "App 不保存账号密码，也不代替登录",
        "适配脚本逐行累积节次，对付 rowspan 跨行",
        "红色斜体的「待筛选」课直接丢弃；解析失败只弹提示，不影响 App 本体"
      ]
    },
    {
      "dot": "rose",
      "title": "离线与隐私",
      "items": [
        "除登录学校教务外不访问网络，无广告、无统计上报",
        "课表 / 调休 / 背景图全部只存本机",
        "选背景图用系统照片选择器，不需要任何存储权限",
        "计算引擎是纯函数，单元测试覆盖覆盖层优先级"
      ]
    }
